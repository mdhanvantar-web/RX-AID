# RX-AID environment template
#
# Server-side Gemini key for the Vercel function at /api/extract.
# Recommended for any deployed build: the key never reaches the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional local-only fallback used directly by the browser.
# WARNING: Vite exposes every VITE_* variable in the browser bundle.
# Never commit a real key; use GEMINI_API_KEY and the serverless proxy instead.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash
